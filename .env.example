# ---------------------------------------------------------------------------
# The Clawson Local — environment variables
# Copy to .env.local for development. In Vercel: Project → Settings →
# Environment Variables (Production + Preview). Never commit real values.
# ---------------------------------------------------------------------------

# Public site URL used for canonical URLs, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://theclawsonlocal.com

# Supabase project URL (Supabase → Project Settings → API).
# NEXT_PUBLIC_SUPABASE_URL is also accepted (set by the Vercel integration).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Public/anon key ("anon" legacy key or "publishable" key). Server-side only in
# this app; subject to Row Level Security (read-only public inventory).
# NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_PUBLISHABLE_KEY are also accepted.
SUPABASE_ANON_KEY=

# Service-role key ("service_role" legacy key or "secret" key). Bypasses RLS.
# SERVER ONLY — never prefix with NEXT_PUBLIC_. Used only by /admin.
# SUPABASE_SECRET_KEY is also accepted.
SUPABASE_SERVICE_ROLE_KEY=

# /admin HTTP Basic auth. Admin is disabled unless ADMIN_PASSWORD is at least
# 16 characters. Use a long random value (e.g. `openssl rand -base64 24`).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Stripe (Phase 3). SERVER ONLY — never prefix with NEXT_PUBLIC_.
# Test mode only for now: a live key (sk_live_/rk_live_) is refused unless
# STRIPE_ALLOW_LIVE=true. Checkout stays disabled (button greyed out) until
# STRIPE_SECRET_KEY is set.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint that points at /api/stripe/webhook
# (Stripe Dashboard → Developers → Webhooks, or `stripe listen` locally).
STRIPE_WEBHOOK_SECRET=
# STRIPE_ALLOW_LIVE=true

# Checkout-hold abuse guard (SERVER ONLY). Random secret used ONLY to HMAC the
# browser token and client IP before they reach the database. At least 32
# characters, e.g. `openssl rand -base64 48`. Not derived from any other key.
# If missing while Stripe is configured, new checkout holds are refused.
HOLD_ABUSE_SECRET=

# Advertiser intake links (Phase 4, SERVER ONLY). Random secret used ONLY to
# derive each paid advertiser's private intake link; the database stores just
# a SHA-256 of the link token. At least 32 characters, e.g.
# `openssl rand -base64 48`. Not derived from any other key. If missing, the
# intake is off: no links are shown and every intake URL returns 404.
# Rotating it invalidates all existing intake links (new ones are issued the
# next time the success page or admin detail page is opened).
INTAKE_TOKEN_SECRET=

# Local testing only (ignored on Vercel): route the SDK to stripe-mock.
# STRIPE_MOCK_URL=http://localhost:12111

# Tests only: superuser connection to a local Postgres used by `npm run test:db`.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
