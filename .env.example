# ---------------------------------------------------------------------------
# The Clawson Local — environment variables
# Copy to .env.local for development. In Vercel: Project → Settings →
# Environment Variables (Production + Preview). Never commit real values.
# ---------------------------------------------------------------------------

# Public site URL used for canonical URLs, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://theclawsonlocal.com

# Supabase project URL (Supabase → Project Settings → API).
# NEXT_PUBLIC_SUPABASE_URL is also accepted (set by the Vercel integration).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Public/anon key ("anon" legacy key or "publishable" key). Server-side only in
# this app; subject to Row Level Security (read-only public inventory).
# NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_PUBLISHABLE_KEY are also accepted.
SUPABASE_ANON_KEY=

# Service-role key ("service_role" legacy key or "secret" key). Bypasses RLS.
# SERVER ONLY — never prefix with NEXT_PUBLIC_. Used only by /admin.
# SUPABASE_SECRET_KEY is also accepted.
SUPABASE_SERVICE_ROLE_KEY=

# /admin HTTP Basic auth. Admin is disabled unless ADMIN_PASSWORD is at least
# 16 characters. Use a long random value (e.g. `openssl rand -base64 24`).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Tests only: superuser connection to a local Postgres used by `npm run test:db`.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
